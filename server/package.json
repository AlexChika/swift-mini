{
  "name": "server",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "// 1. Build commands": "comments.....................",
    "build": "npm run types:check && npm run build:js",
    "build:js": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "// 2. Local Development": "comments.....................",
    "dev": "concurrently -n tsc,tsx 'npm:watch:source' 'npm:watch:types'",
    "watch:source": "tsx watch --env-file=.env src/server.ts",
    "watch:types": "tsc --watch --noEmit --project tsconfig.json",
    "// 3. Code Checks": "comments.....................",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "types:check": "tsc --noEmit",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "// 4. Local Preview": "comments.....................",
    "preview": "node --env-file=.env dist/server.js"
  },
  "keywords": [],
  "author": "Alex Chika",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "axios": "^1.6.2",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^16.3.1",
    "esbuild": "^0.27.4",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "mongoose": "^8.17.1",
    "morgan": "^1.12.1",
    "redis": "^5.9.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/morgan": "^1.9.10",
    "@typescript-eslint/parser": "^8.39.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.39.0"
  },
  "type": "module",
  "imports": {
    "#lib": "./lib",
    "#src": "./src"
  }
}
